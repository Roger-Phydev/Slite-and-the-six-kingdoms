grow_vertical = 2
theme_override_constants/separation = 20

[node name="Text" type="Label" parent="Screen5/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Hasta que de repente, un slime cambio de color y dejó de ser victima del hechizo."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text2" type="Label" parent="Screen5/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Y así comenzó esta historia, la historia de Slite, el segundo héroe de este mundo"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Screen6" type="Panel" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
