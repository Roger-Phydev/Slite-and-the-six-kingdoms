[node name="Text" type="Label" parent="Screen/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Hubo alguna vez un mundo pacífico, lleno de ilusión y felicidad."
horizontal_alignment = 1

[node name="Text2" type="Label" parent="Screen/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "En ese reino sin nombre había equilibrio gracias a cierto elemento raro y mágico de color dorado"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Screen2" type="Panel" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 1152.0
offset_right = 1152.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_d371c")

[node name="VBoxContainer" type="VBoxContainer" parent="Screen2"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -500.0
offset_top = -128.0
offset_right = 500.0
offset_bottom = 128.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Text" type="Label" parent="Screen2/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "En algún momento, la codicia dominó, y una raza forjó monedas con el preciado metal."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text2" type="Label" parent="Screen2/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Pensaron en usarlas como medallas sin conocer las consecuencias"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text3" type="Label" parent="Screen2/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "En cuanto las medallas fueron separadas unas de las otras, comenzó el cataclismo"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Screen3" type="Panel" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 1152.0
offset_right = 1152.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_d371c")

[node name="VBoxContainer" type="VBoxContainer" parent="Screen3"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -500.0
offset_top = -128.0
offset_right = 500.0
offset_bottom = 128.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Text" type="Label" parent="Screen3/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Todo poseedor de alguna de estas medallas era brutalmente atacado por cualquier otro ser viviente del mundo."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text2" type="Label" parent="Screen3/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Pero un héroe ahora olvidado apareció, y logró reunir todas las medallas dispersas por todo el reino."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text3" type="Label" parent="Screen3/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Depositó todas las medallas dentro de un cofre especial que misteriosamente y sin explicación, apareció frente a él al reunir todas las medallas"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Screen4" type="Panel" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 1152.0
offset_right = 1152.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_d371c")

[node name="VBoxContainer" type="VBoxContainer" parent="Screen4"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -500.0
offset_top = -128.0
offset_right = 500.0
offset_bottom = 128.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Text" type="Label" parent="Screen4/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "El tiempo continuo y un día sin previo aviso, un volcán erupcionó violentamente."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text2" type="Label" parent="Screen4/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "El golpe de una roca dio con el cofre legado por el héroe y aunque no destruyó ninguna medalla, las dispersó por todo el reino"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text3" type="Label" parent="Screen4/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "El descontrol de la fauna comenzó, y ahora sin la raza antigua que forjó las monedas, el destino del mundo pendía de un hilo"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Screen5" type="Panel" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
