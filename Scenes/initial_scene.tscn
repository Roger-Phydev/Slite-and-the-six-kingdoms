[node name="Text" type="Label" parent="Screen6/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Una voz interior le decía 
\" vamos Slite, no te rindas, muchas situaciones difíciles vendrán, pero debes llegar hasta el final \""
horizontal_alignment = 1
autowrap_mode = 3

[node name="Text2" type="Label" parent="Screen6/VBoxContainer"]
custom_minimum_size = Vector2(1000, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("6_c1jdr")
theme_override_font_sizes/font_size = 40
text = "Y así, con miedo, dudas, pero también una gran determinación, Slite comenzó su maravillosa aventura para salvar todos los reinos"
horizontal_alignment = 1
autowrap_mode = 3

